    <div class="footer__bottom">© 2026 Perchd. All rights reserved.</div>
  </div>
</footer>

<div class="modal-overlay" id="modalOverlay">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <button type="button" class="modal__close" id="modalClose" aria-label="Close">✕</button>

    <div id="modalFormWrap">
      <h3 id="modalTitle">Start your brief</h3>
      <p class="modal__sub">Tell us a bit about you and we'll set up your strategy interview.</p>
      <form id="briefForm">
        <div class="form-row">
          <label for="fName">Name</label>
          <input type="text" id="fName" name="name" required>
        </div>
        <div class="form-row">
          <label for="fEmail">Email</label>
          <input type="email" id="fEmail" name="email" required>
        </div>
        <div class="form-row">
          <label for="fPhone">Phone</label>
          <input type="tel" id="fPhone" name="phone">
        </div>
        <div class="form-row form-row--split">
          <div>
            <label for="fCompany">Company</label>
            <input type="text" id="fCompany" name="company">
          </div>
          <div>
            <label for="fPosition">Position</label>
            <input type="text" id="fPosition" name="position">
          </div>
        </div>
        <div class="form-row">
          <label for="fLinkedin">LinkedIn profile</label>
          <input type="url" id="fLinkedin" name="linkedin" placeholder="https://linkedin.com/in/...">
        </div>
        <div class="form-row">
          <label for="fPlan">Plan</label>
          <select id="fPlan" name="plan">
            <option value="">Not sure yet</option>
            <option value="starter">Starter ($79/mo)</option>
            <option value="pro">Pro ($199/mo)</option>
            <option value="agency">Agency (from $1,800/mo)</option>
          </select>
        </div>
        <button type="submit" class="btn btn--primary" style="width:100%; margin-top:8px;">Send my info</button>
      </form>
    </div>

    <div id="modalSuccess" hidden>
      <div class="modal__success">
        <h3>You're in.</h3>
        <p>Thanks. We'll follow up at the email you gave us to schedule your strategy interview.</p>
        <button type="button" class="btn btn--ghost" id="modalDone">Close</button>
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  var overlay = document.getElementById('modalOverlay');
  var closeBtn = document.getElementById('modalClose');
  var doneBtn = document.getElementById('modalDone');
  var form = document.getElementById('briefForm');
  var formWrap = document.getElementById('modalFormWrap');
  var success = document.getElementById('modalSuccess');
  var planSelect = document.getElementById('fPlan');
  var titleEl = document.getElementById('modalTitle');

  function planLabel(p){
    if(p === 'starter') return 'Starter';
    if(p === 'pro') return 'Pro';
    if(p === 'agency') return 'Agency';
    return '';
  }

  // Capture UTM parameters on arrival and persist the first touch for
  // the session, so a visitor who lands with UTMs but submits the form
  // later (after browsing around) still gets correctly attributed.
  function getUTMParams(){
    var fields = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];
    var params = new URLSearchParams(window.location.search);
    var current = {};
    var hasAny = false;
    fields.forEach(function(f){
      var v = params.get(f) || '';
      current[f] = v;
      if(v) hasAny = true;
    });

    try {
      if(hasAny){
        sessionStorage.setItem('perchd_utm', JSON.stringify(current));
        return current;
      }
      var stored = sessionStorage.getItem('perchd_utm');
      if(stored) return JSON.parse(stored);
    } catch(err){
      console.error('UTM storage unavailable:', err);
    }

    return current;
  }

  var utmParams = getUTMParams();

  function openModal(plan){
    form.reset();
    planSelect.value = plan || '';
    titleEl.textContent = plan ? 'Start your ' + planLabel(plan) + ' brief' : 'Start your brief';
    formWrap.hidden = false;
    success.hidden = true;
    overlay.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function closeModal(){
    overlay.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('[data-open-modal]').forEach(function(btn){
    btn.addEventListener('click', function(){
      openModal(btn.getAttribute('data-plan'));
    });
  });

  closeBtn.addEventListener('click', closeModal);
  doneBtn.addEventListener('click', closeModal);
  overlay.addEventListener('click', function(e){
    if(e.target === overlay) closeModal();
  });
  document.addEventListener('keydown', function(e){
    if(e.key === 'Escape' && overlay.classList.contains('is-open')) closeModal();
  });

  // Paste your Google Apps Script web app URL here once deployed (ends in /exec)
  var SHEET_ENDPOINT = 'https://script.google.com/macros/s/AKfycbztPpTy91k4GVgCsL9QygPY41oxcOC4j9EF3DKfhXbVPl3nwTTov49xrFRdqGRbVYUsQA/exec';

  form.addEventListener('submit', function(e){
    e.preventDefault();

    var payload = {
      name: document.getElementById('fName').value,
      email: document.getElementById('fEmail').value,
      phone: document.getElementById('fPhone').value,
      company: document.getElementById('fCompany').value,
      position: document.getElementById('fPosition').value,
      linkedin: document.getElementById('fLinkedin').value,
      plan: planSelect.value,
      utm_source: utmParams.utm_source,
      utm_medium: utmParams.utm_medium,
      utm_campaign: utmParams.utm_campaign,
      utm_term: utmParams.utm_term,
      utm_content: utmParams.utm_content
    };

    fetch(SHEET_ENDPOINT, {
      method: 'POST',
      mode: 'no-cors',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify(payload)
    }).catch(function(err){
      console.error('Submission failed to reach the sheet:', err);
    });

    formWrap.hidden = true;
    success.hidden = false;
  });
})();
</script>

</body>
</html>
