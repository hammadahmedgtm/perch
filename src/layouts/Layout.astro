---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const {
  title = "Perchd: You're the Best Salesperson for Your Own Product",
  description = "Perchd is a brand strategist for founders and executives. AI runs the strategy, a real person writes the words, and you choose how involved you want to be.",
  ogTitle,
  ogDescription,
  ogImage = "https://perchd.space/og-image.png",
  canonicalUrl,
} = Astro.props;

const resolvedOgTitle = ogTitle ?? title;
const resolvedOgDescription = ogDescription ?? description;
const resolvedCanonical = canonicalUrl ?? `https://perchd.space${Astro.url.pathname}`;
---
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-V32SZKZH30"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-V32SZKZH30');
</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<link rel="canonical" href={resolvedCanonical}>
<link rel="icon" type="image/png" href="data:image/png;base64,">
<meta name="description" content={description}>
<meta name="theme-color" content="#F0A93A">
<meta name="robots" content="index, follow">
<!-- Open Graph -->
<meta property="og:url" content={resolvedCanonical}>
<meta property="og:type" content="website">
<meta property="og:title" content={resolvedOgTitle}>
<meta property="og:description" content={resolvedOgDescription}>
<meta property="og:image" content={ogImage}>
<meta property="og:site_name" content="Perchd">
<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={resolvedOgTitle}>
<meta name="twitter:description" content={resolvedOgDescription}>
<meta name="twitter:image" content={ogImage}>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <slot />
  <!-- UTM first-touch capture: runs on every page so attribution works even if a
       visitor lands on a blog post and later submits the form on the homepage. -->
  <script>
  (function(){
    try {
      var params = new URLSearchParams(window.location.search);
      var fields = ['utm_source','utm_medium','utm_campaign','utm_term','utm_content'];
      var hasAny = fields.some(function(f){ return params.get(f); });
      if(hasAny){
        var captured = {};
        fields.forEach(function(f){ captured[f] = params.get(f) || ''; });
        sessionStorage.setItem('perchd_utm', JSON.stringify(captured));
      }
    } catch(e){}
  })();
  </script>
</body>
</html>
