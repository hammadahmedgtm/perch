<style is:global>
  .article-page { padding: 64px 0 120px; }
  .article-header { max-width: 760px; margin: 0 auto 56px; }
  .article-header__tag { font-size: 0.78rem; font-weight: 700; color: var(--accent-ink); background: var(--accent-soft); display: inline-block; padding: 4px 12px; border-radius: 999px; margin-bottom: 18px; text-transform: uppercase; letter-spacing: 0.06em; }
  .article-header h1 { font-family: var(--font-display); font-size: clamp(2rem, 4.5vw, 3rem); font-weight: 700; letter-spacing: -0.01em; line-height: 1.1; }
  .article-header__meta { margin-top: 18px; font-size: 0.9rem; color: var(--muted); font-weight: 600; }
  .article-header__deck { margin-top: 16px; font-size: 1.12rem; color: var(--muted); line-height: 1.65; max-width: 640px; }

  .article-body { max-width: 760px; margin: 0 auto; font-size: 1.05rem; line-height: 1.75; color: var(--ink); }
  .article-body p { margin: 0 0 1.4em; }
  .article-body h2 { font-family: var(--font-display); font-size: clamp(1.4rem, 3vw, 1.75rem); font-weight: 700; letter-spacing: -0.01em; margin: 2.2em 0 0.6em; line-height: 1.25; }
  .article-body h3 { font-family: var(--font-display); font-size: 1.15rem; font-weight: 700; margin: 1.8em 0 0.5em; }
  .article-body ul { margin: 0 0 1.4em 0; padding-left: 1.4em; }
  .article-body ul li { margin-bottom: 0.55em; }
  .article-body strong { font-weight: 700; color: var(--ink); }
  .article-body .callout { background: var(--accent-soft); border-left: 3px solid var(--accent); border-radius: 0 12px 12px 0; padding: 18px 22px; margin: 2em 0; color: var(--accent-ink); font-weight: 600; }
  .article-body .sources { margin-top: 3em; padding-top: 1.5em; border-top: 1px solid var(--line); font-size: 0.88rem; color: var(--muted); }
  .article-body .sources p { margin-bottom: 0.4em; }

  .article-cta { max-width: 760px; margin: 56px auto 0; background: var(--accent); border-radius: var(--radius); padding: 40px 36px; }
  .article-cta h3 { font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; color: var(--accent-ink); margin-bottom: 10px; }
  .article-cta p { color: var(--accent-ink); font-size: 1rem; margin-bottom: 22px; opacity: 0.85; }
  .article-back { display: inline-flex; align-items: center; gap: 6px; font-size: 0.88rem; font-weight: 600; color: var(--muted); text-decoration: none; margin-bottom: 32px; }
  .article-back:hover { color: var(--ink); }
  .article-cover { width: 100%; max-width: 760px; margin: 0 auto 48px; display: block; border-radius: var(--radius); overflow: hidden; }
  .article-cover img { width: 100%; height: auto; display: block; }

  @media (max-width: 640px) {
    .article-cta { padding: 28px 22px; }
  }
</style>

